# Copy to `.env` and fill in. Loaded by config.py via python-dotenv.

# --- NCBI E-utilities (PubMed) ---
# An API key raises your rate limit from 3 to 10 requests/sec and is free:
# https://www.ncbi.nlm.nih.gov/account/  -> Settings -> API Key Management
NCBI_API_KEY=
# NCBI asks that you identify your tool + contact email in requests.
NCBI_TOOL=biomed-rag
NCBI_EMAIL=you@example.com

# --- Pinecone ---
PINECONE_API_KEY=
PINECONE_INDEX=biomed-rag
# Serverless cloud/region (free starter tier defaults):
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# --- Embedding model (dense retrieval) ---
# A PubMed-domain bi-encoder makes a strong baseline; swap for your fine-tuned
# checkpoint once the retrieval fine-tuning component is done.
EMBED_MODEL=pritamdeka/S-PubMedBert-MS-MARCO
EMBED_DIM=768
